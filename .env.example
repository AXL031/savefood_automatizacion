# Copia como .env. Usa una contraseña alfanumérica larga (entra en DATABASE_URL).
POSTGRES_PASSWORD=
# Usa una cadena aleatoria larga; no la compartas ni la agregues a Git.
JWT_SECRET=
# Opcional: preferir guardar el token desde Proveedores → Configuración Telegram.
# La configuración de la UI prevalece y se cifra en un volumen con JWT_SECRET.
TELEGRAM_BOT_TOKEN=
ML_COMERCIO_ID=piloto
ML_SUCURSAL_ID=principal
# Tienda del cliente: ID de cliente OAuth (tipo Aplicación web) de Google Cloud.
# Es público. Sin él usa una cuenta local real solo si se habilita expresamente.
GOOGLE_CLIENT_ID=
PUBLIC_BASE_URL=http://localhost:3000
HABILITAR_CLIENTE_LOCAL=0
HABILITAR_ENLACES_PROVEEDOR=1
NEXT_PUBLIC_TIENDA_MODO=api
# Carga sintética solo para base aislada. Generar con iniciar-demo.cmd -Preparar.
HABILITAR_DATOS_PRUEBA=0
DEMO_ADMIN_PASSWORD=
DEMO_OPERADOR_PASSWORD=
DEMO_CLIENTE_PASSWORD=
