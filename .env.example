# Copia como .env. Usa una contraseña alfanumérica larga (entra en DATABASE_URL).
POSTGRES_PASSWORD=
# Usa una cadena aleatoria larga; no la compartas ni la agregues a Git.
JWT_SECRET=
# Opcional: preferir guardar el token desde Proveedores → Configuración Telegram.
# La configuración de la UI prevalece y se cifra en un volumen con JWT_SECRET.
TELEGRAM_BOT_TOKEN=
ML_COMERCIO_ID=piloto
ML_SUCURSAL_ID=principal
# Tienda del cliente: ID de cliente OAuth (tipo Aplicación web) de Google Cloud.
# Es público; opcional y separado del checkout invitado. Origen tienda: http://localhost:3101
GOOGLE_CLIENT_ID=
# Proyecto independiente tienda/ (configuración y secretos en tienda/.env).
TIENDA_ORIGIN=http://localhost:3101
# Integración HTTP independiente (tokens privados distintos por dirección).
TIENDA_INTEGRACION_HABILITADA=0
TIENDA_INTEGRACION_ID=tienda-local
TIENDA_INTEGRACION_TOKEN=
TIENDA_PUBLICACION_TOKEN=
TIENDA_API_INTERNA_URL=http://host.docker.internal:8001
RESERVA_TIENDA_MINUTOS=20

# Opcionales: enlaces de respuesta del proveedor (deshabilitados por defecto).
HABILITAR_ENLACES_PROVEEDOR=0
PUBLIC_BASE_URL=http://localhost:3100
