# Copia como .env. Usa una contraseña alfanumérica larga (entra en DATABASE_URL).
POSTGRES_PASSWORD=
# Usa una cadena aleatoria larga; no la compartas ni la agregues a Git.
JWT_SECRET=
# Opcional: preferir guardar el token desde Proveedores → Configuración Telegram.
# La configuración de la UI prevalece y se cifra en un volumen con JWT_SECRET.
TELEGRAM_BOT_TOKEN=
ML_COMERCIO_ID=piloto
ML_SUCURSAL_ID=principal
