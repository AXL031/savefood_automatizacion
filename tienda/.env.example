# Configuración EXCLUSIVA de la tienda. Copiar a tienda/.env.
TIENDA_ORIGIN=http://localhost:3101
TIENDA_API_URL=http://localhost:8001
FOODSAVE_API_URL=http://localhost:8000
# ejemplo: sin stock FoodSave; api: catálogo publicado y checkout con reserva.
TIENDA_MODO=ejemplo
FOODSAVE_API_INTERNA_URL=http://host.docker.internal:8000
# Privados: corresponden a TIENDA_INTEGRACION_TOKEN y TIENDA_PUBLICACION_TOKEN de FoodSave.
FOODSAVE_INTEGRACION_TOKEN=
FOODSAVE_PUBLICACION_TOKEN=
GOOGLE_CLIENT_ID=

# SOLO credenciales de preproducción entregadas por Payme.
# Completar las tres y cambiar a true; nunca usar NEXT_PUBLIC_ para secretos.
PAYME_HABILITADO=false
PAYME_CLIENT_ID=
PAYME_CLIENT_SECRET=
PAYME_MERCHANT_CODE=
# Opcional: llave pública S2S de sandbox si Payme la renueva; saltos como \n.
PAYME_WEBHOOK_PUBLIC_KEY=
