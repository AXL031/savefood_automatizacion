erDiagram
    %% Esquema de código hasta 0019_tienda_clientes; no certifica despliegue.
    %% Cada movimiento afecta un lote de producto O uno de ingrediente (XOR).
    %% UK se marca solo para unicidad individual e incondicional.
    %% UQ(...) en comentario identifica participación en clave compuesta.
    %% Las relaciones punteadas son no identificadoras (FK fuera de la PK).

    artefacto_modelo {
        integer id PK "NOT NULL"
        varchar(80) version_modelo UK "NOT NULL"
        varchar(160) ruta_local "NOT NULL"
        varchar(64) sha256 "NOT NULL"
        varchar(64) huella_datos_entrenamiento "NOT NULL"
        date fecha_corte_entrenamiento "NOT NULL"
        jsonb particion_json "NOT NULL"
        varchar(16) estado "NOT NULL"
        jsonb metricas_json "NULL"
        timestamptz entrenado_en "NOT NULL"
    }

    cliente {
        integer id PK "NOT NULL"
        varchar(255) google_sub UK "NOT NULL"
        varchar(254) correo "NOT NULL"
        varchar(160) nombre "NOT NULL"
        boolean activo "NOT NULL"
        timestamptz creado_en "NOT NULL"
        timestamptz ultimo_acceso_en "NOT NULL"
    }

    configuracion_flujo {
        integer id PK "NOT NULL"
        jsonb parametros "NOT NULL"
        integer actualizado_por FK "NOT NULL; ref usuario.id"
