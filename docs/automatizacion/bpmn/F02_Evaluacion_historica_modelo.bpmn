<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="F02_defs" targetNamespace="http://foodsave.local/bpmn">
<collaboration id="F02_collab"><participant id="F02_pool" name="FoodSave – F02 Evaluación histórica del modelo (TO-BE)" processRef="F02_proc"/></collaboration>
<process id="F02_proc" name="FoodSave – F02 Evaluación histórica del modelo (TO-BE)" isExecutable="false"><laneSet id="ls1"><lane id="f2_hum" name="Administrador / Analista (actor humano)"><flowNodeRef>u1</flowNodeRef><flowNodeRef>e1</flowNodeRef><flowNodeRef>u2</flowNodeRef><flowNodeRef>e2</flowNodeRef></lane><lane id="f2_mot" name="Motor de automatización (Beat + Worker Celery)"><flowNodeRef>s0</flowNodeRef><flowNodeRef>t1</flowNodeRef><flowNodeRef>t9</flowNodeRef><flowNodeRef>gx</flowNodeRef><flowNodeRef>tm</flowNodeRef><flowNodeRef>tf</flowNodeRef></lane><lane id="f2_ml" name="Servicio ML / Pronósticos (CatBoost)"><flowNodeRef>t2</flowNodeRef><flowNodeRef>g1</flowNodeRef><flowNodeRef>t3</flowNodeRef><flowNodeRef>t7</flowNodeRef><flowNodeRef>g4</flowNodeRef><flowNodeRef>t8</flowNodeRef><flowNodeRef>b1</flowNodeRef></lane><lane id="f2_ven" name="Ventas y base de datos (PostgreSQL)"><flowNodeRef>t4</flowNodeRef><flowNodeRef>g2</flowNodeRef><flowNodeRef>t5</flowNodeRef><flowNodeRef>t6</flowNodeRef><flowNodeRef>g3</flowNodeRef></lane></laneSet><startEvent id="s0" name="Modelo preparado (ECA-1)"><outgoing>f1</outgoing><messageEventDefinition id="s0_md"/></startEvent><serviceTask id="t1" name="Despachar y reclamar tarea (Beat 30 s, lease 120 s)"><incoming>f1</incoming><incoming>f21</incoming><outgoing>f2</outgoing></serviceTask><serviceTask id="t2" name="Leer modelo, partición de prueba y catálogo"><incoming>f2</incoming><outgoing>f3</outgoing></serviceTask><exclusiveGateway id="g1" name="¿Datos válidos? (ECA-2)"><incoming>f3</incoming><outgoing>f4</outgoing><outgoing>f5</outgoing></exclusiveGateway><serviceTask id="t3" name="Generar o recuperar corrida BACKTEST del día D (historia &lt; D)"><incoming>f4</incoming><incoming>f14</incoming><outgoing>f6</outgoing></serviceTask><serviceTask id="t4" name="Consultar venta real histórica del día D"><incoming>f6</incoming><outgoing>f7</outgoing></serviceTask><exclusiveGateway id="g2" name="¿Par evaluable? (ECA-3)"><incoming>f7</incoming><outgoing>f8</outgoing><outgoing>f9</outgoing></exclusiveGateway><serviceTask id="t5" name="Guardar comparación (idempotente por revisión)"><incoming>f8</incoming><outgoing>f10</outgoing></serviceTask><serviceTask id="t6" name="Excluir par de métricas (ausencia ≠ 0)"><incoming>f9</incoming><outgoing>f11</outgoing></serviceTask><exclusiveGateway id="g3" name=""><incoming>f10</incoming><incoming>f11</incoming><outgoing>f12</outgoing></exclusiveGateway><serviceTask id="t7" name="Avanzar al día siguiente del tramo"><incoming>f12</incoming><outgoing>f13</outgoing></serviceTask><exclusiveGateway id="g4" name="¿Quedan días? (ECA-4)"><incoming>f13</incoming><outgoing>f14</outgoing><outgoing>f15</outgoing></exclusiveGateway><serviceTask id="t8" name="Calcular MAE, WAPE, ±20% y cobertura; guardar métricas en el modelo"><incoming>f15</incoming><outgoing>f16</outgoing></serviceTask><serviceTask id="t9" name="Marcar ejecución COMPLETADA con resultado y trazas"><incoming>f16</incoming><outgoing>f17</outgoing></serviceTask><userTask id="u1" name="Consultar Evaluación, Inicio y Reportes"><incoming>f17</incoming><outgoing>f18</outgoing></userTask><endEvent id="e1" name="Métricas disponibles"><incoming>f18</incoming></endEvent><exclusiveGateway id="gx" name="¿Reintentable? (ECA-5)"><incoming>f19</incoming><outgoing>f20</outgoing><outgoing>f22</outgoing></exclusiveGateway><intermediateCatchEvent id="tm" name="Esperar 60–125 s"><incoming>f20</incoming><outgoing>f21</outgoing><timerEventDefinition id="tm_td"/></intermediateCatchEvent><serviceTask id="tf" name="Marcar ejecución FALLIDA con motivo visible"><incoming>f5</incoming><incoming>f22</incoming><outgoing>f23</outgoing></serviceTask><userTask id="u2" name="Revisar motivo en Automatización y decidir acción"><incoming>f23</incoming><outgoing>f24</outgoing></userTask><endEvent id="e2" name="Fallo registrado"><incoming>f24</incoming><errorEventDefinition id="e2_ed"/></endEvent><boundaryEvent id="b1" name="Error interno" attachedToRef="t3" cancelActivity="true"><outgoing>f19</outgoing><errorEventDefinition id="b1_ed"/></boundaryEvent><sequenceFlow id="f1" name="" sourceRef="s0" targetRef="t1"/><sequenceFlow id="f2" name="" sourceRef="t1" targetRef="t2"/><sequenceFlow id="f3" name="" sourceRef="t2" targetRef="g1"/><sequenceFlow id="f4" name="Sí" sourceRef="g1" targetRef="t3"/><sequenceFlow id="f5" name="No: error de datos" sourceRef="g1" targetRef="tf"/><sequenceFlow id="f6" name="" sourceRef="t3" targetRef="t4"/><sequenceFlow id="f7" name="" sourceRef="t4" targetRef="g2"/><sequenceFlow id="f8" name="Sí" sourceRef="g2" targetRef="t5"/><sequenceFlow id="f9" name="No" sourceRef="g2" targetRef="t6"/><sequenceFlow id="f10" name="" sourceRef="t5" targetRef="g3"/><sequenceFlow id="f11" name="" sourceRef="t6" targetRef="g3"/><sequenceFlow id="f12" name="" sourceRef="g3" targetRef="t7"/><sequenceFlow id="f13" name="" sourceRef="t7" targetRef="g4"/><sequenceFlow id="f14" name="Sí" sourceRef="g4" targetRef="t3"/><sequenceFlow id="f15" name="No" sourceRef="g4" targetRef="t8"/><sequenceFlow id="f16" name="" sourceRef="t8" targetRef="t9"/><sequenceFlow id="f17" name="" sourceRef="t9" targetRef="u1"/><sequenceFlow id="f18" name="" sourceRef="u1" targetRef="e1"/><sequenceFlow id="f19" name="" sourceRef="b1" targetRef="gx"/><sequenceFlow id="f20" name="Sí" sourceRef="gx" targetRef="tm"/><sequenceFlow id="f21" name="Reintentar" sourceRef="tm" targetRef="t1"/><sequenceFlow id="f22" name="No" sourceRef="gx" targetRef="tf"/><sequenceFlow id="f23" name="" sourceRef="tf" targetRef="u2"/><sequenceFlow id="f24" name="" sourceRef="u2" targetRef="e2"/><textAnnotation id="F02_n0"><text>LEYENDA (3.12): tareas con icono de persona = actividades HUMANAS; tareas con engranaje / regla = actividades AUTOMÁTICAS del sistema; evento reloj = espera automática; evento rayo = excepción.</text></textAnnotation><textAnnotation id="F02_n1"><text>ESCENARIO A (normal): modelo preparado → backtest día a día → decisión por par → comparación guardada → métricas → verificación en Evaluación. ESCENARIO B (excepción): error de BD o dato inválido → detección en el worker → ¿reintentable? → reintento con espera o FALLIDA → registro y aviso en Automatización.</text></textAnnotation><textAnnotation id="F02_n2"><text>ECA-1: CUANDO F01 guarda un modelo preparado, SI aún no existe una evaluación solicitada con esa clave, ENTONCES reservar la tarea EVALUAR_MODELO.</text></textAnnotation><textAnnotation id="F02_n3"><text>ECA-2: CUANDO se ejecuta la evaluación, SI el modelo o el catálogo no existen, ENTONCES marcar la ejecución FALLIDA con motivo (error de datos, sin reintento).</text></textAnnotation><textAnnotation id="F02_n4"><text>ECA-3: CUANDO se evalúa el día D, SI hay pronóstico DISPONIBLE y venta real conocida, ENTONCES guardar la comparación; SI NO, excluir el par sin tratarlo como cero.</text></textAnnotation><textAnnotation id="F02_n5"><text>ECA-4: CUANDO termina un día, SI quedan fechas en el tramo de prueba, ENTONCES generar la corrida del día siguiente; SI NO, calcular y guardar las métricas.</text></textAnnotation><textAnnotation id="F02_n6"><text>ECA-5: CUANDO un paso falla por error transitorio de BD, SI quedan intentos (máx. 3), ENTONCES reprogramar con espera creciente; SI NO, marcar FALLIDA y mostrar el motivo.</text></textAnnotation></process>
<bpmndi:BPMNDiagram id="F02_di" name="FoodSave – F02 Evaluación histórica del modelo (TO-BE)"><bpmndi:BPMNPlane id="F02_pl" bpmnElement="F02_collab"><bpmndi:BPMNShape id="F02_pool_di" bpmnElement="F02_pool" isHorizontal="true"><dc:Bounds x="40" y="40" width="2545" height="840"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="f2_hum_di" bpmnElement="f2_hum" isHorizontal="true"><dc:Bounds x="70" y="40" width="2515" height="210"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="f2_mot_di" bpmnElement="f2_mot" isHorizontal="true"><dc:Bounds x="70" y="250" width="2515" height="210"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="f2_ml_di" bpmnElement="f2_ml" isHorizontal="true"><dc:Bounds x="70" y="460" width="2515" height="210"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="f2_ven_di" bpmnElement="f2_ven" isHorizontal="true"><dc:Bounds x="70" y="670" width="2515" height="210"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="s0_di" bpmnElement="s0"><dc:Bounds x="144" y="337" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="268" y="319" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="432" y="529" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="632" y="540" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="532" y="506" width="105" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="762" y="529" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="928" y="739" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1128" y="750" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1028" y="716" width="105" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="1258" y="684" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1258" y="794" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g3_di" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="1458" y="750" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1358" y="716" width="105" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1588" y="529" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="g4_di" bpmnElement="g4" isMarkerVisible="true"><dc:Bounds x="1788" y="540" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1688" y="506" width="105" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1918" y="529" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="t9_di" bpmnElement="t9"><dc:Bounds x="2082" y="319" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="u1_di" bpmnElement="u1"><dc:Bounds x="2248" y="109" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="2454" y="127" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="gx_di" bpmnElement="gx" isMarkerVisible="true"><dc:Bounds x="896" y="350" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="796" y="316" width="105" height="32"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="tm_di" bpmnElement="tm"><dc:Bounds x="1052" y="277" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="tf_di" bpmnElement="tf"><dc:Bounds x="1175" y="339" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="u2_di" bpmnElement="u2"><dc:Bounds x="1340" y="109" width="120" height="72"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1547" y="127" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="b1_di" bpmnElement="b1"><dc:Bounds x="852" y="511" width="36" height="36"/