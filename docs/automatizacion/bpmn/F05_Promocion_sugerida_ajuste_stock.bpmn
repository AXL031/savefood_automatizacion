<collaboration id="F05_collab"><participant id="F05_pool" name="FoodSave – F05 Promoción sugerida tras ajustar stock (TO-BE)" processRef="F05_proc"/></collaboration>
<process id="F05_proc" name="FoodSave – F05 Promoción sugerida tras ajustar stock (TO-BE)" isExecutable="false"><laneSet id="ls1"><lane id="f5_hum" name="Encargado de tienda (actor humano)"><flowNodeRef>s0</flowNodeRef><flowNodeRef>u1</flowNodeRef><flowNodeRef>u2</flowNodeRef><flowNodeRef>u3</flowNodeRef><flowNodeRef>g7</flowNodeRef><flowNodeRef>m1</flowNodeRef><flowNodeRef>e1</flowNodeRef><flowNodeRef>e2</flowNodeRef><flowNodeRef>u4</flowNodeRef><flowNodeRef>e4</flowNodeRef></lane><lane id="f5_inv" name="Inventario (API FastAPI)"><flowNodeRef>t1</flowNodeRef><flowNodeRef>g1</flowNodeRef><flowNodeRef>t2</flowNodeRef><flowNodeRef>g2</flowNodeRef><flowNodeRef>e0</flowNodeRef></lane><lane id="f5_mot" name="Motor de automatización (Beat + Worker Celery)"><flowNodeRef>t4</flowNodeRef><flowNodeRef>tm</flowNodeRef><flowNodeRef>t5</flowNodeRef><flowNodeRef>t9</flowNodeRef><flowNodeRef>gx</flowNodeRef><flowNodeRef>tx</flowNodeRef><flowNodeRef>tf</flowNodeRef></lane><lane id="f5_pro" name="Promociones (motor de reglas)"><flowNodeRef>t3</flowNodeRef><flowNodeRef>g3</flowNodeRef><flowNodeRef>e3</flowNodeRef><flowNodeRef>t6</flowNodeRef><flowNodeRef>g4</flowNodeRef><flowNodeRef>r1</flowNodeRef><flowNodeRef>g5</flowNodeRef><flowNodeRef>t7</flowNodeRef><flowNodeRef>t8</flowNodeRef><flowNodeRef>g6</flowNodeRef><flowNodeRef>b1</flowNodeRef></lane></laneSet><startEvent id="s0" name="Excedente detectado"><outgoing>f1</outgoing></startEvent><userTask id="u1" name="Registrar ajuste de stock del lote (cantidad, motivo, hora)"><incoming>f1</incoming><incoming>f6</incoming><outgoing>f2</outgoing></userTask><serviceTask id="t1" name="Validar ajuste (cantidad, motivo, clave, hora local)"><incoming>f2</incoming><outgoing>f3</outgoing></serviceTask><exclusiveGateway id="g1" name="¿Datos válidos?"><incoming>f3</incoming><outgoing>f4</outgoing><outgoing>f5</outgoing></exclusiveGateway><userTask id="u2" name="Corregir datos según el error 422 mostrado"><incoming>f5</incoming><outgoing>f6</outgoing></userTask><serviceTask id="t2" name="Bloquear lote y guardar saldo + movimiento AJUSTE"><incoming>f4</incoming><outgoing>f7</outgoing></serviceTask><exclusiveGateway id="g2" name="¿Clave nueva? (ECA-4)"><incoming>f7</incoming><outgoing>f8</outgoing><outgoing>f9</outgoing></exclusiveGateway><endEvent id="e0" name="Ajuste ya registrado"><incoming>f8</incoming></endEvent><serviceTask id="t3" name="Leer última regla de promoción"><incoming>f9</incoming><outgoing>f10</outgoing></serviceTask><exclusiveGateway id="g3" name="¿Regla activa? (ECA-1)"><incoming>f10</incoming><outgoing>f11</outgoing><outgoing>f12</outgoing></exclusiveGateway><endEvent id="e3" name="Sin promoción"><incoming>f11</incoming></endEvent><serviceTask id="t4" name="Reservar EVALUAR_PROMOCION con regla y lectura conservadas"><incoming>f12</incoming><outgoing>f13</outgoing></serviceTask><intermediateCatchEvent id="tm" name="Esperar demora (5–3600 s)"><incoming>f13</incoming><outgoing>f14</outgoing><timerEventDefinition id="tm_td"/></intermediateCatchEvent><serviceTask id="t5" name="Despachar y reclamar tarea (Beat 30 s)"><incoming>f14</incoming><incoming>f32</incoming><outgoing>f15</outgoing></serviceTask><serviceTask id="t6" name="Releer estado actual del lote"><incoming>f15</incoming><outgoing>f16</outgoing></serviceTask><exclusiveGateway id="g4" name="¿Lectura vigente? (ECA-2)"><incoming>f16</incoming><outgoing>f17</outgoing><outgoing>f18</outgoing></exclusiveGateway><businessRuleTask id="r1" name="Aplicar regla: vence hoy, ventana 17–20 h, lectura ≤ 30 min, stock &gt; umbral"><incoming>f17</incoming><outgoing>f19</outgoing></businessRuleTask><exclusiveGateway id="g5" name="¿Cumple regla? (ECA-3)"><incoming>f19</incoming><outgoing>f20</outgoing><outgoing>f21</outgoing></exclusiveGateway><serviceTask id="t7" name="Guardar SUGERENCIA con descuento (20 %) y motivo"><incoming>f20</incoming><outgoing>f22</outgoing></serviceTask><serviceTask id="t8" name="Guardar evaluación SIN promoción con motivo"><incoming>f18</incoming><incoming>f21</incoming><outgoing>f23</outgoing></serviceTask><exclusiveGateway id="g6" name=""><incoming>f22</incoming><incoming>f23</incoming><outgoing>f24</outgoing></exclusiveGateway><serviceTask id="t9" name="Marcar ejecución COMPLETADA con trazas"><incoming>f24</incoming><outgoing>f25</outgoing></serviceTask><userTask id="u3" name="Revisar sugerencia en pantalla Promociones"><incoming>f25</incoming><outgoing>f26</outgoing></userTask><exclusiveGateway id="g7" name="¿Aplicar descuento?"><incoming>f26</incoming><outgoing>f27</outgoing><outgoing>f29</outgoing></exclusiveGateway><manualTask id="m1" name="Aplicar descuento en punto de venta (fuera del sistema)"><incoming>f27</incoming><outgoing>f28</outgoing></manualTask><endEvent id="e1" name="Promoción aplicada"><incoming>f28</incoming></endEvent><endEvent id="e2" name="Sugerencia descartada"><incoming>f29</incoming></endEvent><exclusiveGateway id="gx" name="¿Reintentable? (ECA-5)"><incoming>f30</incoming><outgoing>f31</outgoing><outgoing>f33</outgoing></exclusiveGateway><intermediateCatchEvent id="tx" name="Esperar 60–125 s"><incoming>f31</incoming><outgoing>f32</outgoing><timerEventDefinition id="tx_td"/></intermediateCatchEvent><serviceTask id="tf" name="Marcar ejecución FALLIDA con motivo visible"><incoming>f33</incoming><outgoing>f34</outgoing></serviceTask><userTask id="u4" name="Revisar fallo en Automatización y registrar nuevo ajuste si aplica"><incoming>f34</incoming><outgoing>f35</outgoing></userTask><endEvent id="e4" name="Fallo registrado"><incoming>f35</incoming><errorEventDefinition id="e4_ed"/></endEvent><boundaryEvent id="b1" name="Error interno" attachedToRef="t6" cancelActivity="true"><outgoing>f30</outgoing><errorEventDefinition id="b1_ed"/></boundaryEvent><sequenceFlow id="f1" name="" sourceRef="s0" targetRef="u1"/><sequenceFlow id="f2" name="" sourceRef="u1" targetRef="t1"/><sequenceFlow id="f3" name="" sourceRef="t1" targetRef="g1"/><sequenceFlow id="f4" name="Sí" sourceRef="g1" targetRef="t2"/><sequenceFlow id="f5" name="No" sourceRef="g1" targetRef="u2"/><sequenceFlow id="f6" name="" sourceRef="u2" targetRef="u1"/><sequenceFlow id="f7" name="" sourceRef="t2" targetRef="g2"/><sequenceFlow id="f8" name="No" sourceRef="g2" targetRef="e0"/><sequenceFlow id="f9" name="Sí" sourceRef="g2" targetRef="t3"/><sequenceFlow id="f10" name="" sourceRef="t3" targetRef="g3"/><sequenceFlow id="f11" name="No" sourceRef="g3" targetRef="e3"/><sequenceFlow id="f12" name="Sí" sourceRef="g3" targetRef="t4"/><sequenceFlow id="f13" name="" sourceRef="t4" targetRef="tm"/><sequenceFlow id="f14" name="" sourceRef="tm" targetRef="t5"/><sequenceFlow id="f15" name="" sourceRef="t5" targetRef="t6"/><sequenceFlow id="f16" name="" sourceRef="t6" targetRef="g4"/><sequenceFlow id="f17" name="Sí" sourceRef="g4" targetRef="r1"/><sequenceFlow id="f18" name="No" sourceRef="g4" targetRef="t8"/><sequenceFlow id="f19" name="" sourceRef="r1" targetRef="g5"/><sequenceFlow id="f20" name="Sí" sourceRef="g5" targetRef="t7"/><sequenceFlow id="f21" name="No" sourceRef="g5" targetRef="t8"/><sequenceFlow id="f22" name="" sourceRef="t7" targetRef="g6"/><sequenceFlow id="f23" name="" sourceRef="t8" targetRef="g6"/><sequenceFlow id="f24" name="" sourceRef="g6" targetRef="t9"/><sequenceFlow id="f25" name="" sourceRef="t9" targetRef="u3"/><sequenceFlow id="f26" name="" sourceRef="u3" targetRef="g7"/><sequenceFlow id="f27" name="Sí" sourceRef="g7" targetRef="m1"/><sequenceFlow id="f28" name="" sourceRef="m1" targetRef="e1"/><sequenceFlow id="f29" name="No" sourceRef="g7" targetRef="e2"/><sequenceFlow id="f30" name="" sourceRef="b1" targetRef="gx"/><sequenceFlow id="f31" name="Sí" sourceRef="gx" targetRef="tx"/><sequenceFlow id="f32" name="Reintentar" sourceRef="tx" targetRef="t5"/><sequenceFlow id="f33" name="No" sourceRef="gx" targetRef="tf"/><sequenceFlow id="f34" name="" sourceRef="tf" targetRef="u4"/><sequenceFlow id="f35" name="" sourceRef="u4" targetRef="e4"/><textAnnotation id="F05_n0"><text>LEYENDA (3.12): tareas con icono de persona = actividades HUMANAS; tareas con engranaje / regla = actividades AUTOMÁTICAS del sistema; evento reloj = espera automática; evento rayo = excepción.</text></textAnnotation><textAnnotation id="F05_n1"><text>ESCENARIO A (normal): ajuste de stock → validación → regla habilitada → espera → evaluación de condiciones → sugerencia guardada → revisión humana. ESCENARIO B (excepción): dato inválido (422) o error transitorio en el worker → detección → corrección humana o reintento automático → FALLIDA registrada y visible.</text></textAnnotation><textAnnotation id="F05_n2"><text>ECA-1: CUANDO se registra un ajuste nuevo de producto terminado, SI la regla de promoción está habilitada, ENTONCES reservar EVALUAR_PROMOCION tras la demora configurada.</text></textAnnotation><textAnnotation id="F05_n3"><text>ECA-2: CUANDO vence la demora, SI otro movimiento reemplazó la lectura, falta la fecha límite o el lote está vencido, ENTONCES guardar la evaluación rechazada con su motivo.</text></textAnnotation><textAnnotation id="F05_n4"><text>ECA-3: CUANDO la lectura es vigente, SI el producto vence hoy, está en la ventana 17–20 h, la lectura tiene ≤ 30 min y el stock supera el umbral, ENTONCES sugerir el descuento configurado.</text></textAnnotation><textAnnotation id="F05_n5"><text>ECA-4: CUANDO llega un ajuste con una clave de operación ya registrada, SI el contenido coincide, ENTONCES recuperar el resultado sin sumar stock ni reservar otra tarea.</text></textAnnotation><textAnnotation id="F05_n6"><text>ECA-5: CUANDO un paso del worker falla por error transitorio, SI quedan intentos (máx. 3), ENTONCES reprogramar con espera creciente; SI NO, marcar FALLIDA y mostrar el motivo.</text></textAnnotation></process>
